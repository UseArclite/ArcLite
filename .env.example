# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# --- chain ---
ARCLITE_CHAIN_ID=46630                      # 4663 mainnet | 46630 testnet
ARCLITE_RPC_URL=                            # optional private RPC; defaults to the public one

# --- supabase ---
# Session pooler (port 5432) for migrations and crons; transaction pooler (6543) for the
# request path, with prepare:false — transaction pooling does not support prepared statements
# and omitting that fails intermittently rather than loudly.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- dashboard features ---
# Comma-separated list of dashboard panels to switch on. Unset means every one is off, which is
# the safe default and what a fresh preview gets. `all` turns on everything — for local work and
# previews, never as the production default.
#
# VITE_ is read at build time, so changing this needs a redeploy before it shows.
# Current flags: positions, logos, guard-reasons, price-age, tx-receipts, preflight
VITE_ARCLITE_FEATURES=

# --- vercel ---
CRON_SECRET=
INTERNAL_SECRET=

# --- phase 3+ ---
RELAYER_PRIVATE_KEY=                        # testnet only; mainnet must use KMS
KMS_KEY_ID=

# Testnet deployer. Generate with `bun scripts/new-deployer.mjs` — it writes the key to
# .env.local and prints only the address, so the secret never reaches a terminal or a log.
#
# TESTNET ONLY. Mainnet must never carry a plaintext key: the startup assertion refuses to boot
# on chain 4663 when this is set and KMS_KEY_ID is not.
DEPLOYER_PRIVATE_KEY=0x...
