//! Tests for the crossing proof.
//!
//! The positive case exists to prove the constraints are satisfiable at all. The negative cases
//! are the point: each one is an attack the venue must refuse, and each fails for a *named*
//! reason rather than because the witness happened to be malformed. A constraint system that
//! accepts everything passes every positive test ever written.

use crate::{main, N_ORDERS, N_OUTPUTS};
use arclite::merkle::{compute_root, hash2, DEPTH};
use arclite::note::{commitment, nullifier, owner_of, Note};
use arclite::price::{prices_root, PriceEntry, MAX_ASSETS};
use crate::QUOTE_SCALE;

/// The registry's id for the quote asset, which is now a public input rather than a constant.
/// Deliberately not adjacent to `ASSET`: the circuit refuses a window whose committed table
/// prices the quote asset, and a test that used the same number for both would pass for the
/// wrong reason.
global QUOTE_ASSET_ID: Field = 4;

global DOMAIN_ORDER: Field = 0x6f72646572;
global DOMAIN_RECEIPT: Field = 0x72637074;
global DOMAIN_TAPE: Field = 0x74617065;

global WINDOW: Field = 77;
global SUB_BATCH: Field = 0;
global VERSION: Field = 1;
global PRICED_AT: Field = 1789000000;
global ASSET: Field = 1;

// Public keys for the test secrets 111, 222 and 777 on Grumpkin, and the signatures over each
// scenario's spend messages. Generated by `bun scripts/gen-circuit-fixtures.mjs`, because Noir
// cannot sign — `s = k − e·sk` is arithmetic modulo Grumpkin's scalar field, which is BN254's
// base field rather than the `Field` a circuit works in.
//
// That these fixtures satisfy the in-circuit verifier is the evidence that the TypeScript signer
// and the circuit agree, which is the property that actually has to hold.
global PK0_X: Field = 0x0afff4a58eec4ad025b7ffea6cd3ce835cd38f9da249eccf0a0dbb25b116e478;
global PK0_Y: Field = 0x188e8883345089b8ea655fabc453b05e51bc1cd40d8fced151f51131840fcaab;
global PK1_X: Field = 0x12e11c7197bf84a9ad82132db3056f6e779e5fb14b9bcf17333155dc49cf456b;
global PK1_Y: Field = 0x2751afa025bfbfc6766ba5ad1c92a72888a77724a6914ee841016939ba0ec63b;
global PK2_X: Field = 0x08a5294c80494c16effe27d8f381bceb0a7fcd7f32014561eb36c6fed87c78ea;
global PK2_Y: Field = 0x127b5e49ea892587761861576cef26298859231fe21fbe8ecfa591e07f343cb5;

/// The note owner a slot's key material implies. Derived, never chosen — the same derivation the
/// circuit performs.
fn owner_at(c: Case, i: u32) -> Field {
    owner_of(c.pk_x[i], c.pk_y[i], c.npk[i])
}

/// Every argument `main` takes, so a test can build a valid crossing and then break exactly one
/// thing. Keeping them in one struct is what makes each negative test a one-line diff from the
/// honest case — which is how you can see what is actually being tested.
struct Case {
    entries: [PriceEntry; MAX_ASSETS],
    asset_count: u32,
    sequencer_ok: bool,
    asset_selector: [[Field; MAX_ASSETS]; N_ORDERS],
    side: [Field; N_ORDERS],
    quantity: [Field; N_ORDERS],
    filled: [Field; N_ORDERS],
    order_salt: [Field; N_ORDERS],
    active: [Field; N_ORDERS],
    in_units: [Field; N_ORDERS],
    /// Grumpkin public keys and nullifier keys. `owner` is *derived* from these, so a test
    /// cannot spend a note without a signature from the key that owns it — which is the point.
    pk_x: [Field; N_ORDERS],
    pk_y: [Field; N_ORDERS],
    npk: [Field; N_ORDERS],
    sig_s_lo: [Field; N_ORDERS],
    sig_s_hi: [Field; N_ORDERS],
    sig_e_lo: [Field; N_ORDERS],
    sig_e_hi: [Field; N_ORDERS],
    nsecret: [Field; N_ORDERS],
    leaf_index: [Field; N_ORDERS],
    path: [[Field; DEPTH]; N_ORDERS],
    asset_buy_total: [Field; MAX_ASSETS],
    asset_sell_total: [Field; MAX_ASSETS],
    asset_matched: [Field; MAX_ASSETS],
    buy_is_smaller: [Field; MAX_ASSETS],
    prorata_q: [Field; N_ORDERS],
    prorata_r: [Field; N_ORDERS],
    max_cost_q: [Field; N_ORDERS],
    max_cost_r: [Field; N_ORDERS],
    out_commitment: [Field; N_OUTPUTS],
    quote_q: [Field; N_ORDERS],
    quote_r: [Field; N_ORDERS],
    nullifiers: [Field; N_ORDERS],
}

fn empty_entry() -> PriceEntry {
    PriceEntry {
        asset_id: 0,
        kind: 0,
        flags: 0,
        updated_at: 0,
        round_id: 0,
        ref_value_e18: 0,
        ui_multiplier_e18: 0,
    }
}

/// The zero-subtree ladder, matching `CommitmentTree`'s constructor.
fn zeros() -> [Field; DEPTH] {
    let mut z: [Field; DEPTH] = [0; DEPTH];
    let mut current: Field = 0;
    for i in 0..DEPTH {
        z[i] = current;
        current = hash2(current, current);
    }
    z
}

/// A tree holding exactly two leaves, at indices 0 and 1, with both authentication paths.
fn two_leaf_tree(c0: Field, c1: Field) -> (Field, [Field; DEPTH], [Field; DEPTH]) {
    let z = zeros();
    let mut p0: [Field; DEPTH] = z;
    let mut p1: [Field; DEPTH] = z;
    p0[0] = c1; // sibling of leaf 0 is leaf 1
    p1[0] = c0;
    let root = compute_root(c0, p0, 0);
    (root, p0, p1)
}

fn subtree_root(leaves: [Field; N_OUTPUTS]) -> Field {
    let mut level = leaves;
    for _ in 0..5 {
        let mut next: [Field; N_OUTPUTS] = [0; N_OUTPUTS];
        for j in 0..(N_OUTPUTS / 2) {
            next[j] = hash2(level[j * 2], level[j * 2 + 1]);
        }
        level = next;
    }
    level[0]
}

/// One buyer for 100 units, one seller of 40, on a single healthy asset.
///
/// The smaller side is the sell, so the matched size is 40: the seller fills completely and the
/// buyer fills 40 with 60 resting. Chosen because it exercises a partial fill, an exact
/// (remainder-free) pro-rata share, and fourteen padding slots at once.
fn honest_case() -> Case {
    let mut entries = [empty_entry(); MAX_ASSETS];
    entries[0] = PriceEntry {
        asset_id: ASSET,
        kind: 0,
        flags: 0,
        updated_at: PRICED_AT,
        round_id: 12345,
        ref_value_e18: 222450000000000000000, // $222.45
        ui_multiplier_e18: 1000775159164630595,
    };

    let mut asset_selector = [[0; MAX_ASSETS]; N_ORDERS];
    for i in 0..N_ORDERS {
        asset_selector[i][0] = 1;
    }

    let mut side: [Field; N_ORDERS] = [0; N_ORDERS];
    side[1] = 1; // order 1 sells

    let mut quantity: [Field; N_ORDERS] = [0; N_ORDERS];
    quantity[0] = 100;
    quantity[1] = 40;

    let mut filled: [Field; N_ORDERS] = [0; N_ORDERS];
    filled[0] = 40;
    filled[1] = 40;

    let mut active: [Field; N_ORDERS] = [0; N_ORDERS];
    active[0] = 1;
    active[1] = 1;

    let mut in_units: [Field; N_ORDERS] = [0; N_ORDERS];
    in_units[0] = 100;
    in_units[1] = 40;

    // Public keys for secrets 111, 222 and 777, generated by scripts/gen-circuit-fixtures.mjs.
    // A test cannot invent these: the signature below is over a message only that secret can
    // sign, and the circuit derives `owner` from the key.
    let mut pk_x: [Field; N_ORDERS] = [PK0_X; N_ORDERS];
    let mut pk_y: [Field; N_ORDERS] = [PK0_Y; N_ORDERS];
    pk_x[1] = PK1_X;
    pk_y[1] = PK1_Y;
    pk_x[2] = PK2_X;
    pk_y[2] = PK2_Y;
    let mut npk: [Field; N_ORDERS] = [0; N_ORDERS];
    npk[0] = 7;
    npk[1] = 9;
    npk[2] = 11;
    // Signatures over the honest case's two spends. Regenerate with
    // `bun scripts/gen-circuit-fixtures.mjs` if the book, the window or the message format change
    // — every one of those is inside what was signed, which is the whole point.
    let mut sig_s_lo: [Field; N_ORDERS] = [0; N_ORDERS];
    let mut sig_s_hi: [Field; N_ORDERS] = [0; N_ORDERS];
    let mut sig_e_lo: [Field; N_ORDERS] = [0; N_ORDERS];
    let mut sig_e_hi: [Field; N_ORDERS] = [0; N_ORDERS];
    sig_s_lo[0] = 0x8bbe269a2bbaefeca676080088fa264c;
    sig_s_hi[0] = 0x21b45613f9404d4bf9a6484d951676a;
    sig_e_lo[0] = 0x5618f719384989db911c85e9c667c5e0;
    sig_e_hi[0] = 0x2669e380daaf6c828290e8daf90f3489;
    sig_s_lo[1] = 0xe2fc048f893d8ab552c0fff0b8f146b4;
    sig_s_hi[1] = 0x1193654e0118c75f49bdb77edbae8d88;
    sig_e_lo[1] = 0xac001dca331deaee13036bcc96560532;
    sig_e_hi[1] = 0x250fb95359c2b109bf396649e83c19f0;

    let mut nsecret: [Field; N_ORDERS] = [0; N_ORDERS];
    nsecret[0] = 333;
    nsecret[1] = 444;

    let mut order_salt: [Field; N_ORDERS] = [0; N_ORDERS];
    order_salt[0] = 555;
    order_salt[1] = 666;

    let owner0 = owner_of(pk_x[0], pk_y[0], npk[0]);
    let owner1 = owner_of(pk_x[1], pk_y[1], npk[1]);
    let c0 = commitment(Note { asset_id: QUOTE_ASSET_ID, units: 100, owner: owner0, nsecret: 333 });
    let c1 = commitment(Note { asset_id: ASSET, units: 40, owner: owner1, nsecret: 444 });
    let (_, p0, p1) = two_leaf_tree(c0, c1);

    let mut path = [[0; DEPTH]; N_ORDERS];
    path[0] = p0;
    path[1] = p1;

    let mut leaf_index: [Field; N_ORDERS] = [0; N_ORDERS];
    leaf_index[1] = 1;

    let mut nullifiers: [Field; N_ORDERS] = [0; N_ORDERS];
    nullifiers[0] = nullifier(c0, 333, 0);
    nullifiers[1] = nullifier(c1, 444, 1);

    let mut asset_buy_total: [Field; MAX_ASSETS] = [0; MAX_ASSETS];
    let mut asset_sell_total: [Field; MAX_ASSETS] = [0; MAX_ASSETS];
    let mut asset_matched: [Field; MAX_ASSETS] = [0; MAX_ASSETS];
    let buy_is_smaller: [Field; MAX_ASSETS] = [0; MAX_ASSETS];
    asset_buy_total[0] = 100;
    asset_sell_total[0] = 40;
    asset_matched[0] = 40;
    // The sell side is smaller, so the bit stays 0 — including for all the empty rows, where
    // both totals are zero and either answer is consistent.

    // quantity × matched / side_total, per order.
    let mut prorata_q: [Field; N_ORDERS] = [0; N_ORDERS];
    let prorata_r: [Field; N_ORDERS] = [0; N_ORDERS];
    prorata_q[0] = 40; // 100 × 40 / 100
    prorata_q[1] = 40; //  40 × 40 /  40

    // Outputs are derived, not chosen: the circuit rebuilds them from the book and compares, so
    // a test that invented them would simply fail. Built here the same way, which is also the
    // only way a settler can construct a valid subtree.
    let out_commitment: [Field; N_OUTPUTS] = [0; N_OUTPUTS];
    let quote_q: [Field; N_ORDERS] = [0; N_ORDERS];
    let quote_r: [Field; N_ORDERS] = [0; N_ORDERS];

    let mut c = Case {
        entries,
        asset_count: 1,
        sequencer_ok: true,
        asset_selector,
        side,
        quantity,
        filled,
        order_salt,
        active,
        in_units,
        pk_x,
        pk_y,
        npk,
        sig_s_lo,
        sig_s_hi,
        sig_e_lo,
        sig_e_hi,
        nsecret,
        leaf_index,
        path,
        asset_buy_total,
        asset_sell_total,
        asset_matched,
        buy_is_smaller,
        prorata_q,
        prorata_r,
        max_cost_q: [0; N_ORDERS],
        max_cost_r: [0; N_ORDERS],
        out_commitment,
        quote_q,
        quote_r,
        nullifiers,
    };
    derive_outputs(&mut c);
    c
}

/// Rebuild the outputs the circuit will insist on.
///
/// Kept as a helper so every negative test that changes a fill or a quantity gets consistent
/// outputs for free — otherwise each one would fail on the output check rather than on the
/// property it means to test, which would make the whole suite meaningless.
fn derive_outputs(c: &mut Case) {
    let mut out: [Field; N_OUTPUTS] = [0; N_OUTPUTS];
    let mut qq: [Field; N_ORDERS] = [0; N_ORDERS];
    let mut qr: [Field; N_ORDERS] = [0; N_ORDERS];
    let mut mcq: [Field; N_ORDERS] = [0; N_ORDERS];
    let mut mcr: [Field; N_ORDERS] = [0; N_ORDERS];

    for i in 0..N_ORDERS {
        let mut asset_id: Field = 0;
        let mut ref_value: Field = 0;
        for a in 0..MAX_ASSETS {
            asset_id = asset_id + c.asset_selector[i][a] * c.entries[a].asset_id;
            ref_value = ref_value + c.asset_selector[i][a] * c.entries[a].ref_value_e18;
        }

        let product = c.filled[i] * ref_value;
        let q = field_div(product, QUOTE_SCALE);
        qq[i] = q;
        qr[i] = product - q * QUOTE_SCALE;

        // The whole order's quote cost, which is what a buyer's note has to cover.
        let max_product = c.quantity[i] * ref_value;
        let mq = field_div(max_product, QUOTE_SCALE);
        mcq[i] = mq;
        mcr[i] = max_product - mq * QUOTE_SCALE;

        let is_sell = c.side[i];
        let out_asset = (1 - is_sell) * asset_id + is_sell * QUOTE_ASSET_ID;
        let out_units = (1 - is_sell) * c.filled[i] + is_sell * q;

        // A buyer funds the trade with quote and pays the rounding up; a seller funds it with
        // the asset and is paid the rounding down.
        let note_asset = (1 - is_sell) * QUOTE_ASSET_ID + is_sell * asset_id;
        let spent = (1 - is_sell) * (q + (qr[i] != 0) as Field) + is_sell * c.filled[i];

        let residual = Note {
            asset_id: note_asset,
            units: c.in_units[i] - spent,
            owner: owner_of(c.pk_x[i], c.pk_y[i], c.npk[i]),
            nsecret: hash2(c.nsecret[i], hash2(WINDOW, 0)),
        };
        let received = Note {
            asset_id: out_asset,
            units: out_units,
            owner: owner_of(c.pk_x[i], c.pk_y[i], c.npk[i]),
            nsecret: hash2(c.nsecret[i], hash2(WINDOW, 1)),
        };

        out[i * 2] = if c.active[i] == 1 { commitment(residual) } else { 0 };
        out[i * 2 + 1] = if c.active[i] == 1 { commitment(received) } else { 0 };
    }

    c.out_commitment = out;
    c.quote_q = qq;
    c.quote_r = qr;
    c.max_cost_q = mcq;
    c.max_cost_r = mcr;
}

/// Integer division on Field values, for building test witnesses only.
///
/// Noir's `/` is a modular inverse, so this walks the bits instead. Never used in the circuit —
/// there every division is witnessed and proven.
fn field_div(a: Field, b: Field) -> Field {
    let a_bits: [bool; 254] = a.to_be_bits();
    let mut q: Field = 0;
    let mut rem: Field = 0;
    for i in 0..254 {
        rem = rem * 2 + if a_bits[i] { 1 } else { 0 };
        let fits = lt_field(b, rem + 1);
        rem = rem - if fits { b } else { 0 };
        q = q * 2 + if fits { 1 } else { 0 };
    }
    q
}

fn lt_field(x: Field, y: Field) -> bool {
    // x < y for values well inside 128 bits, which every quantity here is.
    let d = y - x;
    (d != 0) & (d.lt(0x100000000000000000000000000000000))
}

/// Derive the public inputs a case implies, then run `main`.
///
/// The public inputs are recomputed from the witness rather than stored in `Case`, so a negative
/// test that changes the book automatically changes the roots too. That matters: otherwise most
/// "attacks" would fail merely because a hash stopped matching, and the constraint being tested
/// would never be reached.
fn run(c: Case) {
    let (proot, mask) =
        prices_root(c.entries, c.asset_count, WINDOW, PRICED_AT, c.sequencer_ok);

    let mut book = hash2(DOMAIN_ORDER, WINDOW);
    book = hash2(book, SUB_BATCH);
    for i in 0..N_ORDERS {
        let mut asset_id: Field = 0;
        for a in 0..MAX_ASSETS {
            asset_id = asset_id + c.asset_selector[i][a] * c.entries[a].asset_id;
        }
        let leaf = hash2(
            hash2(hash2(asset_id, c.side[i]), c.quantity[i]),
            hash2(owner_of(c.pk_x[i], c.pk_y[i], c.npk[i]), c.order_salt[i]),
        );
        let chained = hash2(book, leaf);
        book = if c.active[i] == 1 { chained } else { book };
    }

    let mut old_root: Field = 0;
    for i in 0..N_ORDERS {
        if c.active[i] == 1 {
            let mut asset_id: Field = 0;
            for a in 0..MAX_ASSETS {
                asset_id = asset_id + c.asset_selector[i][a] * c.entries[a].asset_id;
            }
            // The note's asset is not the order's asset for a buy: buyers fund with quote.
            let note = Note {
                asset_id: (1 - c.side[i]) * QUOTE_ASSET_ID + c.side[i] * asset_id,
                units: c.in_units[i],
                owner: owner_of(c.pk_x[i], c.pk_y[i], c.npk[i]),
                nsecret: c.nsecret[i],
            };
            old_root = compute_root(commitment(note), c.path[i], c.leaf_index[i]);
        }
    }

    let mut receipts = hash2(DOMAIN_RECEIPT, WINDOW);
    for i in 0..N_ORDERS {
        let mut asset_id: Field = 0;
        for a in 0..MAX_ASSETS {
            asset_id = asset_id + c.asset_selector[i][a] * c.entries[a].asset_id;
        }
        let leaf = hash2(
            hash2(c.nullifiers[i], c.filled[i]),
            hash2(c.quantity[i], asset_id),
        );
        receipts = hash2(receipts, leaf);
    }

    let mut tape = hash2(hash2(DOMAIN_TAPE, WINDOW), hash2(SUB_BATCH, VERSION));
    for a in 0..MAX_ASSETS {
        let next = hash2(tape, hash2(c.entries[a].asset_id, c.asset_matched[a]));
        tape = if a < c.asset_count { next } else { tape };
    }

    main(
        VERSION,
        WINDOW,
        SUB_BATCH,
        old_root,
        book,
        proot,
        mask,
        QUOTE_ASSET_ID,
        subtree_root(c.out_commitment),
        receipts,
        tape,
        c.nullifiers,
        c.entries,
        c.asset_count,
        PRICED_AT,
        c.sequencer_ok,
        c.asset_selector,
        c.side,
        c.quantity,
        c.filled,
        c.order_salt,
        c.active,
        c.in_units,
        c.pk_x,
        c.pk_y,
        c.npk,
        c.sig_s_lo,
        c.sig_s_hi,
        c.sig_e_lo,
        c.sig_e_hi,
        c.nsecret,
        c.leaf_index,
        c.path,
        c.asset_buy_total,
        c.asset_sell_total,
        c.asset_matched,
        c.buy_is_smaller,
        c.prorata_q,
        c.prorata_r,
        c.max_cost_q,
        c.max_cost_r,
        c.out_commitment,
        c.quote_q,
        c.quote_r,
    );
}

/// Run a case whose public `prices_root` and `defer_mask` come from a *different* table than the
/// one the prover witnesses. Everything else is derived from the case as usual, so the only thing
/// wrong is the table — which is what makes the failure attributable.
fn run_with_committed_table(
    c: Case,
    committed: [PriceEntry; MAX_ASSETS],
    committed_count: u32,
) {
    let (proot, mask) = prices_root(committed, committed_count, WINDOW, PRICED_AT, c.sequencer_ok);

    let mut book = hash2(DOMAIN_ORDER, WINDOW);
    book = hash2(book, SUB_BATCH);
    for i in 0..N_ORDERS {
        let mut asset_id: Field = 0;
        for a in 0..MAX_ASSETS {
            asset_id = asset_id + c.asset_selector[i][a] * c.entries[a].asset_id;
        }
        let leaf = hash2(
            hash2(hash2(asset_id, c.side[i]), c.quantity[i]),
            hash2(owner_of(c.pk_x[i], c.pk_y[i], c.npk[i]), c.order_salt[i]),
        );
        let chained = hash2(book, leaf);
        book = if c.active[i] == 1 { chained } else { book };
    }

    let mut old_root: Field = 0;
    for i in 0..N_ORDERS {
        if c.active[i] == 1 {
            let mut asset_id: Field = 0;
            for a in 0..MAX_ASSETS {
                asset_id = asset_id + c.asset_selector[i][a] * c.entries[a].asset_id;
            }
            // The note's asset is not the order's asset for a buy: buyers fund with quote.
            let note = Note {
                asset_id: (1 - c.side[i]) * QUOTE_ASSET_ID + c.side[i] * asset_id,
                units: c.in_units[i],
                owner: owner_of(c.pk_x[i], c.pk_y[i], c.npk[i]),
                nsecret: c.nsecret[i],
            };
            old_root = compute_root(commitment(note), c.path[i], c.leaf_index[i]);
        }
    }

    let mut receipts = hash2(DOMAIN_RECEIPT, WINDOW);
    for i in 0..N_ORDERS {
        let mut asset_id: Field = 0;
        for a in 0..MAX_ASSETS {
            asset_id = asset_id + c.asset_selector[i][a] * c.entries[a].asset_id;
        }
        let leaf = hash2(
            hash2(c.nullifiers[i], c.filled[i]),
            hash2(c.quantity[i], asset_id),
        );
        receipts = hash2(receipts, leaf);
    }

    let mut tape = hash2(hash2(DOMAIN_TAPE, WINDOW), hash2(SUB_BATCH, VERSION));
    for a in 0..MAX_ASSETS {
        let next = hash2(tape, hash2(c.entries[a].asset_id, c.asset_matched[a]));
        tape = if a < c.asset_count { next } else { tape };
    }

    main(
        VERSION,
        WINDOW,
        SUB_BATCH,
        old_root,
        book,
        proot,
        mask,
        QUOTE_ASSET_ID,
        subtree_root(c.out_commitment),
        receipts,
        tape,
        c.nullifiers,
        c.entries,
        c.asset_count,
        PRICED_AT,
        c.sequencer_ok,
        c.asset_selector,
        c.side,
        c.quantity,
        c.filled,
        c.order_salt,
        c.active,
        c.in_units,
        c.pk_x,
        c.pk_y,
        c.npk,
        c.sig_s_lo,
        c.sig_s_hi,
        c.sig_e_lo,
        c.sig_e_hi,
        c.nsecret,
        c.leaf_index,
        c.path,
        c.asset_buy_total,
        c.asset_sell_total,
        c.asset_matched,
        c.buy_is_smaller,
        c.prorata_q,
        c.prorata_r,
        c.max_cost_q,
        c.max_cost_r,
        c.out_commitment,
        c.quote_q,
        c.quote_r,
    );
}

#[test]
fn honest_crossing_verifies() {
    run(honest_case());
}

// ---------------------------------------------------------------------------------------
// conservation
// ---------------------------------------------------------------------------------------

#[test(should_fail)]
fn buyer_cannot_receive_more_than_sellers_gave() {
    // The mint. Buy side filled 50 against a sell side that only filled 40.
    let mut c = honest_case();
    c.filled[0] = 50;
    c.asset_matched[0] = 50;
    c.prorata_q[0] = 50;
    run(c);
}

#[test(should_fail)]
fn seller_cannot_deliver_more_than_buyers_took() {
    let mut c = honest_case();
    c.filled[1] = 30;
    run(c);
}

#[test(should_fail)]
fn matcher_cannot_withhold_liquidity() {
    // Both sides could have crossed 40; crossing only 20 is the operator quietly keeping the
    // rest of the book for a later window, or for itself.
    let mut c = honest_case();
    c.filled[0] = 20;
    c.filled[1] = 20;
    c.asset_matched[0] = 20;
    c.prorata_q[0] = 20;
    c.prorata_q[1] = 20;
    run(c);
}

#[test(should_fail)]
fn cannot_claim_the_larger_side_is_the_minimum() {
    // buy_is_smaller lies: it says the 100-unit buy side is the smaller one, which would let the
    // matched size exceed what sellers actually offered.
    let mut c = honest_case();
    c.buy_is_smaller[0] = 1;
    c.asset_matched[0] = 100;
    run(c);
}

#[test(should_fail)]
fn cannot_fill_beyond_the_order() {
    let mut c = honest_case();
    c.quantity[1] = 40;
    c.filled[1] = 60;
    run(c);
}

#[test(should_fail)]
fn cannot_sell_more_than_the_note_holds() {
    // The note holds 40 units; offering 80 of it is a withdrawal against nothing.
    let mut c = honest_case();
    c.quantity[1] = 80;
    run(c);
}

// ---------------------------------------------------------------------------------------
// fairness
// ---------------------------------------------------------------------------------------

#[test]
fn pro_rata_splits_a_shared_side() {
    // Two buyers, 30 and 10, against a single 20-unit seller: shares of 15 and 5, exactly.
    let mut c = honest_case();
    c.side[2] = 0;
    c.active[2] = 1;
    c.quantity[0] = 30;
    c.quantity[2] = 10;
    c.quantity[1] = 20;
    c.in_units[0] = 30;
    c.in_units[2] = 10;
    c.in_units[1] = 20;
    
    c.nsecret[2] = 888;
    c.order_salt[2] = 999;
    c.filled[0] = 15;
    c.filled[2] = 5;
    c.filled[1] = 20;
    c.asset_buy_total[0] = 40;
    c.asset_sell_total[0] = 20;
    c.asset_matched[0] = 20;
    c.prorata_q[0] = 15; // 30 × 20 / 40
    c.prorata_q[2] = 5; //  10 × 20 / 40
    c.prorata_q[1] = 20; //  20 × 20 / 20

    // Three notes now, so rebuild the tree. Leaf 2 shares the level-1 subtree with a zero.
    // Owners are derived from the key material, exactly as the circuit derives them — a literal
    // owner here would be a note nobody holds the key to.
    let c0 = commitment(Note { asset_id: QUOTE_ASSET_ID, units: 30, owner: owner_at(c, 0), nsecret: 333 });
    let c1 = commitment(Note { asset_id: ASSET, units: 20, owner: owner_at(c, 1), nsecret: 444 });
    let c2 = commitment(Note { asset_id: QUOTE_ASSET_ID, units: 10, owner: owner_at(c, 2), nsecret: 888 });
    let z = zeros();

    let mut p0 = z;
    let mut p1 = z;
    let mut p2 = z;
    p0[0] = c1;
    p1[0] = c0;
    p0[1] = hash2(c2, z[0]);
    p1[1] = hash2(c2, z[0]);
    p2[0] = z[0];
    p2[1] = hash2(c0, c1);
    for i in 2..DEPTH {
        p0[i] = z[i];
        p1[i] = z[i];
        p2[i] = z[i];
    }
    c.path[0] = p0;
    c.path[1] = p1;
    c.path[2] = p2;
    c.leaf_index[2] = 2;
    c.nullifiers[0] = nullifier(c0, 333, 0);
    c.nullifiers[1] = nullifier(c1, 444, 1);
    c.nullifiers[2] = nullifier(c2, 888, 2);

    // A different book means different signed messages: quantity and the nullifier are both
    // inside what was signed, so this scenario needs its own signatures.
    c.sig_s_lo[0] = 0xf8a5efef79e764892c620e00ddb2fd58;
    c.sig_s_hi[0] = 0xd3fbf2c7b8c870722e7635f481ca5c;
    c.sig_e_lo[0] = 0x613f615faf742a4657c6b427dc2a2bf9;
    c.sig_e_hi[0] = 0x26268f1333f70a1f78a1544c892795e6;
    c.sig_s_lo[1] = 0xf7ae508a9a5ffc1f9b239e5571fcf8be;
    c.sig_s_hi[1] = 0x26aed1ee6afc630bfb2460e3e5dd6fad;
    c.sig_e_lo[1] = 0xe94ae888cb6c1cf1782b34d438fda89a;
    c.sig_e_hi[1] = 0x183688485ec16832e8748d13a8dde527;
    c.sig_s_lo[2] = 0x2dc382548804d651fc51da2b694141a5;
    c.sig_s_hi[2] = 0x1142e317a3ed16dea1518f7895b22853;
    c.sig_e_lo[2] = 0x9ae0052b1cd80c5bdf22db98c90cb7f3;
    c.sig_e_hi[2] = 0x20f1016771d86e5683d273e7f092846e;

    // The book changed, so the outputs the circuit insists on changed with it.
    derive_outputs(&mut c);
    run(c);
}

#[test(should_fail)]
fn cannot_favour_one_trader_over_another() {
    // Same two buyers, but the whole 20 goes to the first. Every conservation check still
    // passes — the sides balance — so only the pro-rata bound catches this.
    let mut c = honest_case();
    c.side[2] = 0;
    c.active[2] = 1;
    c.quantity[0] = 30;
    c.quantity[2] = 10;
    c.quantity[1] = 20;
    c.in_units[0] = 30;
    c.in_units[2] = 10;
    c.in_units[1] = 20;
    
    c.nsecret[2] = 888;
    c.filled[0] = 20;
    c.filled[2] = 0;
    c.filled[1] = 20;
    c.asset_buy_total[0] = 40;
    c.asset_sell_total[0] = 20;
    c.asset_matched[0] = 20;
    c.prorata_q[0] = 15;
    c.prorata_q[2] = 5;
    c.prorata_q[1] = 20;
    run(c);
}

// ---------------------------------------------------------------------------------------
// guards
// ---------------------------------------------------------------------------------------

#[test]
fn a_deferred_asset_crosses_nothing() {
    let mut c = honest_case();
    c.entries[0].flags = 1; // FLAG_STALE
    c.filled[0] = 0;
    c.filled[1] = 0;
    c.asset_matched[0] = 0;
    c.prorata_q[0] = 0;
    c.prorata_q[1] = 0;
    // The matched size must still be the smaller side's total for the no-withholding check, so
    // a deferred asset needs its book to look empty rather than merely unfilled.
    c.asset_buy_total[0] = 0;
    c.asset_sell_total[0] = 0;
    c.active[0] = 0;
    c.active[1] = 0;
    c.quantity[0] = 0;
    c.quantity[1] = 0;
    c.nullifiers[0] = 0;
    c.nullifiers[1] = 0;
    derive_outputs(&mut c);
    run(c);
}

#[test(should_fail)]
fn a_guarded_asset_cannot_be_crossed() {
    // Acceptance criterion 3, as a constraint: the guard is set and the matcher crossed anyway.
    let mut c = honest_case();
    c.entries[0].flags = 4; // FLAG_EVENT — a corporate action window
    run(c);
}

#[test(should_fail)]
fn cannot_hide_a_guard_from_the_published_mask() {
    // The attack this whole design exists to stop: the contract committed a table saying NVDA is
    // in an event window, and the prover crosses it anyway by proving against a table with the
    // flag cleared.
    //
    // It fails because `prices_root` is derived *inside* the circuit from the witnessed table and
    // compared to the public input the contract published. There is no way to present one table
    // to the hash and another to the crossing. This is what makes on-chain price derivation
    // load-bearing rather than decorative — moving it off-chain would hollow out exactly this.
    let honest = honest_case();
    let mut flagged = honest_case();
    flagged.entries[0].flags = 4; // FLAG_EVENT
    run_with_committed_table(honest, flagged.entries, flagged.asset_count);
}

#[test(should_fail)]
fn cannot_swap_in_a_better_price_after_sealing() {
    // Same shape, different motive: prove against a table whose reference price is higher than
    // the one committed. The seal-then-price ordering denies the operator the option; this
    // constraint denies the prover the substitution.
    let honest = honest_case();
    let mut richer = honest_case();
    richer.entries[0].ref_value_e18 = 400000000000000000000; // $400 instead of $222.45
    run_with_committed_table(honest, richer.entries, richer.asset_count);
}

// ---------------------------------------------------------------------------------------
// padding and replay
// ---------------------------------------------------------------------------------------

#[test(should_fail)]
fn a_padding_slot_cannot_carry_a_fill() {
    let mut c = honest_case();
    c.filled[5] = 10;
    run(c);
}

#[test(should_fail)]
fn a_padding_slot_cannot_publish_a_nullifier() {
    // Otherwise an inactive slot could burn someone else's note.
    let mut c = honest_case();
    c.nullifiers[5] = 12345;
    run(c);
}

#[test(should_fail)]
fn cannot_spend_a_note_that_is_not_in_the_tree() {
    let mut c = honest_case();
    c.in_units[1] = 41; // a note that was never committed
    run(c);
}

#[test(should_fail)]
fn cannot_substitute_a_nullifier() {
    // The double-spend shape: a valid crossing published under a nullifier nobody can link to
    // the note that was actually spent.
    let mut c = honest_case();
    c.nullifiers[1] = 999999;
    run(c);
}

#[test(should_fail)]
fn an_order_cannot_be_priced_at_another_assets_row() {
    // Two rows in the table; the order's note says asset 1 but the selector points at row 1.
    let mut c = honest_case();
    c.entries[1] = PriceEntry {
        asset_id: 2,
        kind: 0,
        flags: 0,
        updated_at: PRICED_AT,
        round_id: 1,
        ref_value_e18: 1,
        ui_multiplier_e18: 1,
    };
    c.asset_count = 2;
    c.asset_selector[0][0] = 0;
    c.asset_selector[0][1] = 1;
    run(c);
}

#[test(should_fail)]
fn a_selector_must_name_exactly_one_row() {
    let mut c = honest_case();
    c.asset_selector[0][1] = 1; // now two rows selected
    run(c);
}

// ---------------------------------------------------------------------------------------
// outputs — who the proceeds belong to
// ---------------------------------------------------------------------------------------

#[test(should_fail)]
fn cannot_redirect_the_proceeds_to_another_owner() {
    // The attack this section exists for, and the one that was possible until the outputs were
    // constrained: spend a trader's note and pay the proceeds into a note somebody else owns.
    // Every conservation check still passes — the same number of units crossed — because
    // conservation is about how much moved, not about who received it.
    let mut c = honest_case();
    let thief: Field = 999;
    let received = Note {
        asset_id: QUOTE_ASSET_ID,
        units: c.quote_q[1],
        owner: thief,
        nsecret: hash2(c.nsecret[1], hash2(WINDOW, 1)),
    };
    c.out_commitment[3] = commitment(received);
    run(c);
}

#[test(should_fail)]
fn cannot_shrink_a_traders_proceeds() {
    // Skimming: pay the seller less than the reference says the fill was worth, and keep the
    // difference in a leaf nobody is checking.
    let mut c = honest_case();
    let received = Note {
        asset_id: QUOTE_ASSET_ID,
        units: c.quote_q[1] - 1,
        owner: owner_at(c, 1),
        nsecret: hash2(c.nsecret[1], hash2(WINDOW, 1)),
    };
    c.out_commitment[3] = commitment(received);
    run(c);
}

#[test(should_fail)]
fn cannot_withhold_the_residual() {
    // The unfilled part of an order has to come back. Zeroing the residual leaf would strand it.
    let mut c = honest_case();
    c.out_commitment[0] = 0;
    run(c);
}

#[test(should_fail)]
fn a_padding_slot_cannot_carry_an_output() {
    // Otherwise a settlement could mint a note out of an empty order slot.
    let mut c = honest_case();
    c.out_commitment[10] = 12345;
    run(c);
}

#[test(should_fail)]
fn cannot_pay_a_seller_in_the_asset_they_sold() {
    // A seller receives quote units. Paying them back in the asset would return what they just
    // gave up while the buyer keeps the units too.
    let mut c = honest_case();
    let wrong = Note {
        asset_id: c.entries[0].asset_id,
        units: c.filled[1],
        owner: owner_at(c, 1),
        nsecret: hash2(c.nsecret[1], hash2(WINDOW, 1)),
    };
    c.out_commitment[3] = commitment(wrong);
    run(c);
}

#[test(should_fail)]
fn cannot_witness_a_false_quote_conversion() {
    // The quote value is a witnessed division, so the prover supplies it. Claiming a quotient
    // the arithmetic does not support has to fail, or the conversion constrains nothing.
    let mut c = honest_case();
    c.quote_q[1] = c.quote_q[1] + 1;
    run(c);
}

// ---------------------------------------------------------------------------------------
// spend authority
// ---------------------------------------------------------------------------------------

#[test(should_fail)]
fn cannot_spend_without_the_owners_signature() {
    // The gap this section closes. Before it existed, spending a note needed only the `owner`
    // preimage and `nsecret` — both of which a settler reads straight out of a revealed order.
    // It could not redirect the trade once the outputs were constrained, but it could replay the
    // same note into a later batch and cross it again. Knowing a secret is not being authorised
    // to use it.
    let mut c = honest_case();
    c.sig_s_lo[0] = c.sig_s_lo[0] + 1;
    run(c);
}

#[test(should_fail)]
fn a_signature_does_not_transfer_between_orders() {
    // The slot index is deliberately *not* signed — the sealer assigns it after submission, so a
    // trader signing offline could not know it. What stops a signature moving is that the
    // nullifier, the quantity and the side are all inside the message, so one order's
    // authorisation is worthless for another.
    let mut c = honest_case();
    c.sig_s_lo[0] = c.sig_s_lo[1];
    c.sig_s_hi[0] = c.sig_s_hi[1];
    c.sig_e_lo[0] = c.sig_e_lo[1];
    c.sig_e_hi[0] = c.sig_e_hi[1];
    run(c);
}

#[test(should_fail)]
fn cannot_forge_an_owner_for_a_key_you_hold() {
    // `owner` is derived from the key material rather than witnessed, so claiming somebody
    // else's note means producing a signature under a key whose public half hashes to their
    // owner — which is the discrete log.
    let mut c = honest_case();
    c.npk[0] = c.npk[0] + 1;
    run(c);
}

#[test(should_fail)]
fn a_signature_is_bound_to_its_window() {
    // Otherwise an authorisation from one window would settle in the next, which is precisely
    // the replay this exists to stop. Changing the note's leaf index changes its nullifier,
    // which is inside the signed message.
    let mut c = honest_case();
    c.leaf_index[1] = 5;
    run(c);
}

#[test]
fn an_order_smaller_than_its_note_returns_the_whole_remainder() {
    // A note is spent whole: its nullifier is published, so everything it held that did not fill
    // has to come back. Offering part of a note must not forfeit the rest — which it did, until
    // the residual was computed from `in_units` rather than `quantity`.
    let mut c = honest_case();
    c.in_units[1] = 100; // the seller's note holds 100
    c.quantity[1] = 40; //  but only 40 is offered

    // Rebuild the tree: a different note is a different commitment.
    let c0 = commitment(Note { asset_id: QUOTE_ASSET_ID, units: 100, owner: owner_at(c, 0), nsecret: 333 });
    let c1 = commitment(Note { asset_id: ASSET, units: 100, owner: owner_at(c, 1), nsecret: 444 });
    let z = zeros();
    let mut p0 = z;
    let mut p1 = z;
    p0[0] = c1;
    p1[0] = c0;
    c.path[0] = p0;
    c.path[1] = p1;
    c.nullifiers[0] = nullifier(c0, 333, 0);
    c.nullifiers[1] = nullifier(c1, 444, 1);

    // Quantity and the nullifier are both signed, so this book needs its own signatures.
    c.sig_s_lo[0] = 0x4c39ad6e35c4db55795f68d06f66e246;
    c.sig_s_hi[0] = 0x1a119c514757beb6844ff16ba77832b0;
    c.sig_e_lo[0] = 0xd3a57ac9f6061df9e1faa57c91a62fff;
    c.sig_e_hi[0] = 0x18d21b79a85858c1dc4bd48d9c665f78;
    c.sig_s_lo[1] = 0x4cabfdf46378c9a283c9cbd1db37ce1d;
    c.sig_s_hi[1] = 0x27fcab6630ab2f8fc47d92f812dc6a0a;
    c.sig_e_lo[1] = 0x10385cdba18ed5a6cb5d61ef7e4b5104;
    c.sig_e_hi[1] = 0x17892483cd1c35ab1fd9f0238ec77e15;

    derive_outputs(&mut c);
    run(c);
}

/// Build the honest book again, but at the decimals the venue actually runs at.
///
/// Every other case here trades single-digit unit counts, where `filled × ref_value / 10^30`
/// floors to zero: the seller is paid nothing, the buyer pays nothing, and a quote leg that moves
/// no value looks identical to one that works. One whole 18-decimal unit at $222.45 costs
/// 222450000 six-decimal USDG, which is large enough for the arithmetic to mean something.
fn realistic_scale_case() -> Case {
    let unit: Field = 1000000000000000000; // 1e18 raw = one whole token
    let quote_units: Field = 300000000; // 300 USDG at 6 decimals, more than the order can cost

    let mut c = honest_case();
    c.quantity[0] = unit;
    c.quantity[1] = unit;
    c.filled[0] = unit;
    c.filled[1] = unit;
    c.in_units[0] = quote_units; // the buyer funds with quote
    c.in_units[1] = unit; // the seller funds with the asset
    c.asset_buy_total[0] = unit;
    c.asset_sell_total[0] = unit;
    c.asset_matched[0] = unit;
    c.prorata_q[0] = unit;
    c.prorata_q[1] = unit;

    let c0 = commitment(
        Note { asset_id: QUOTE_ASSET_ID, units: quote_units, owner: owner_at(c, 0), nsecret: 333 },
    );
    let c1 = commitment(Note { asset_id: ASSET, units: unit, owner: owner_at(c, 1), nsecret: 444 });
    let (_, p0, p1) = two_leaf_tree(c0, c1);
    c.path[0] = p0;
    c.path[1] = p1;
    c.nullifiers[0] = nullifier(c0, 333, 0);
    c.nullifiers[1] = nullifier(c1, 444, 1);

    c.sig_s_lo[0] = 0x7a679c41eac15e69126edf1de464fe92;
    c.sig_s_hi[0] = 0x116174d14328594c9a21a64f3692d38a;
    c.sig_e_lo[0] = 0xb5c909913de1bc9e3cc9818034e46612;
    c.sig_e_hi[0] = 0xba477988f4de40abdf256881eda1ba6;
    c.sig_s_lo[1] = 0x3e331594373ef909afd494fcb2eb47ad;
    c.sig_s_hi[1] = 0x214b0fda9251f46ba4a3605b0a02ed9a;
    c.sig_e_lo[1] = 0x3a48ea78a75540c5cf59028bd58d714d;
    c.sig_e_hi[1] = 0x2628b4d84725839439dbb704ed90cbf;

    derive_outputs(&mut c);
    c
}

#[test]
fn a_buyer_pays_quote_for_what_it_receives() {
    let c = realistic_scale_case();
    // 1e18 × 222.45e18 / 1e30 = 222450000, exactly — so this asserts the real number, not just
    // that the circuit agrees with the test helper.
    assert(c.quote_q[0] == 222450000);
    assert(c.quote_r[0] == 0);

    // What the circuit will insist the outputs are. Written out rather than derived so the
    // economics are legible: the buyer's quote note is drawn down and comes back smaller, and
    // the seller hands over the asset and gets the quote.
    let buyer = owner_at(c, 0);
    let seller = owner_at(c, 1);
    let buyer_residual =
        Note { asset_id: QUOTE_ASSET_ID, units: 77550000, owner: buyer, nsecret: hash2(333, hash2(WINDOW, 0)) };
    let buyer_received = Note {
        asset_id: ASSET,
        units: 1000000000000000000,
        owner: buyer,
        nsecret: hash2(333, hash2(WINDOW, 1)),
    };
    let seller_residual =
        Note { asset_id: ASSET, units: 0, owner: seller, nsecret: hash2(444, hash2(WINDOW, 0)) };
    let seller_received = Note {
        asset_id: QUOTE_ASSET_ID,
        units: 222450000,
        owner: seller,
        nsecret: hash2(444, hash2(WINDOW, 1)),
    };
    assert(c.out_commitment[0] == commitment(buyer_residual));
    assert(c.out_commitment[1] == commitment(buyer_received));
    assert(c.out_commitment[2] == commitment(seller_residual));
    assert(c.out_commitment[3] == commitment(seller_received));

    run(c);
}

#[test(should_fail)]
fn a_buyer_cannot_order_more_than_its_quote_note_covers() {
    // 222450000 is the exact cost, so one unit short of it is one unit too little. Before buyers
    // funded with quote there was nothing to be short of: a buy spent a note of the asset it was
    // buying and the quote side was never funded at all.
    let mut c = realistic_scale_case();
    c.in_units[0] = 222449999;

    let c0 = commitment(
        Note { asset_id: QUOTE_ASSET_ID, units: 222449999, owner: owner_at(c, 0), nsecret: 333 },
    );
    let c1 = commitment(Note {
        asset_id: ASSET,
        units: 1000000000000000000,
        owner: owner_at(c, 1),
        nsecret: 444,
    });
    let (_, p0, p1) = two_leaf_tree(c0, c1);
    c.path[0] = p0;
    c.path[1] = p1;
    c.nullifiers[0] = nullifier(c0, 333, 0);
    c.nullifiers[1] = nullifier(c1, 444, 1);

    derive_outputs(&mut c);
    run(c);
}
